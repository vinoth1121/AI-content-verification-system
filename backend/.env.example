# =============================================================================
# AI Content Verification System — Backend Configuration
# Copy this file to .env and edit values. NEVER commit .env.
# =============================================================================

# App
APP_NAME=AI Content Verification System
APP_ENV=development            # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# CORS — comma-separated allow-list
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,chrome-extension://*

# Database
DATABASE_URL=sqlite:///./acvs.db    # production: postgresql+psycopg2://user:pass@host:5432/acvs

# Redis (rate limit + cache) — optional in dev
REDIS_URL=redis://localhost:6379/0

# Rate limits
RATE_LIMIT_GLOBAL=60/minute
RATE_LIMIT_SCAN=5/minute

# AI Engine
AI_ENGINE_URL=http://localhost:9000   # if running engine as a sidecar; null = in-process
AI_ENGINE_TIMEOUT=30

# File upload limits
MAX_TEXT_LENGTH=50000
MAX_IMAGE_MB=10
MAX_AUDIO_MB=50
MAX_VIDEO_MB=100

# Retention
UPLOAD_AUTO_DELETE_SECONDS=300

{
  "name": "acvs-browser-extension",
  "version": "0.1.0",
  "description": "Browser extension for the AI Content Verification System (Manifest V3).",
  "scripts": {
    "build": "webpack --config webpack.config.js --mode production",
    "dev": "webpack --config webpack.config.js --mode development --watch",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "package": "npm run build && cd dist && zip -r ../acvs-extension.zip ."
  },
  "devDependencies": {
    "@types/chrome": "^0.0.260",
    "@types/jest": "^29.5.12",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "copy-webpack-plugin": "^12.0.2"
  }
}
